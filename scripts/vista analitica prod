CREATE VIEW gold.dim_products AS
SELECT
	ROW_NUMBER() OVER (ORDER BY pn.prd_start_dt,pn.prd_key) AS clave_del_prodcuto,
	pn.prd_id AS id_del_prodcuto,
	pn.prd_key AS key_del_prod,
	pn.prd_nm AS nombre_del_prodcuto,
	pn.cat_id AS id_cateogria,
	pc.cat AS categoria,
	pc.subcat AS subcategoria,
	pc.maintenance AS mantenimineto,
	pn.prd_cost AS costo,
	pn.prd_line AS rubro,
	pn.prd_start_dt AS fecha 
FROM silver.crm_prd_info pn
LEFT JOIN silver.erp_px_cat_g1v2 pc
ON pn.cat_id = pc.id
WHERE prd_end_dt IS NULL
