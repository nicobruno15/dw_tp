SELECT
prd_id,
COUNT(*)
FROM bronze.crm_prd_info
GROUP BY prd_id
HAVING COUNT(*) > 1 or prd_id IS NULL

SELECT prd_nm
FROM bronze.crm_prd_info
WHERE prd_nm != TRIM(prd_nm)

-- bscamos negativos o nulos
SELECT prd_cost
FROM bronze.crm_prd_info
WHERE prd_cost < 0 OR prd_cost IS NULL
-- vemos lo sdatos de prd_line
SELECT DISTINCT prd_line
FROM bronze.crm_prd_info

-- vemos fechas nivalidas
SELECT *
FROM bronze.crm_prd_info
WHERE prd_end_dt < prd_start_dt


-- hacemos lo mismo pero para el nivel silver
SELECT
prd_id,
COUNT(*)
FROM silver.crm_prd_info
GROUP BY prd_id
HAVING COUNT(*) > 1 or prd_id IS NULL

SELECT prd_nm
FROM silver.crm_prd_info
WHERE prd_nm != TRIM(prd_nm)

-- bscamos negativos o nulos
SELECT prd_cost
FROM silver.crm_prd_info
WHERE prd_cost < 0 OR prd_cost IS NULL
-- vemos lo sdatos de prd_line
SELECT DISTINCT prd_line
FROM silver.crm_prd_info

-- vemos fechas nivalidas
SELECT *
FROM silver.crm_prd_info
WHERE prd_end_dt < prd_start_dt

SELECT *
from silver.crm_prd_info
